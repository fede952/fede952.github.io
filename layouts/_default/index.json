{{- /* Search index for the command palette (extend_footer.html). "section"
     is the localized content type ("Tool", "Guide", ...), shown as the
     label of each result. */ -}}
{{- $index := slice -}}
{{- range .Site.RegularPages -}}
  {{- $type := partial "page-type.html" . | default (.Type | humanize | title) -}}
  {{- $index = $index | append (dict "title" .Title "permalink" .Permalink "summary" (plainify .Summary | truncate 100) "section" $type "date" (.Date.Format "2006-01-02")) -}}
{{- end -}}
{{- $index | jsonify -}}
