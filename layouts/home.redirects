{{- /* Cloudflare Pages redirects, generated by Hugo (output format
     "redirects" in hugo.toml). GitHub Pages ignores this file; there the
     alias pages (meta refresh) and static/404.html do the same job.
     First match wins, so exact paths come before wildcards. Aliases are
     language-relative in front matter (Hugo semantics), so "/x/" on an IT
     page means /it/x/; EN aliases are also emitted without the /en prefix
     to cover the old root-level English URLs. */ -}}
# Generated by Hugo from front-matter aliases. Do not edit by hand.
/ /en/ 302
{{ range hugo.Sites }}
{{- $lang := .Language.Lang }}
{{- range .Pages }}
{{- $to := .RelPermalink }}
{{- range .Aliases }}
{{- /* .Aliases holds the effective path, language prefix included and
     trailing slash stripped (e.g. "/it/cheatsheets/x"). */}}
{{- $from := printf "%s/" (strings.TrimSuffix "/" .) }}
{{ $from }} {{ $to }} 301
{{- $root := strings.TrimPrefix "/en" $from }}
{{- /* ...unless a real static file lives there (e.g. the game apps in
     static/games/<x>/ that the game pages embed). */}}
{{- if and (eq $lang "en") (not (fileExists (printf "static%sindex.html" $root))) }}
{{ $root }} {{ $to }} 301
{{- end }}
{{- end }}
{{- end }}
{{- end }}

# Removed languages (Phase 3): same path in English
{{- range slice "zh-cn" "hi" "ar" "ja" "ru" "ko" }}
/{{ . }}/* /en/:splat 301
{{- end }}

# Removed news section (Phase 2)
/news/* /en/learn/ 301
{{- range hugo.Sites }}
/{{ .Language.Lang }}/news/* /{{ .Language.Lang }}/learn/ 301
{{- end }}
